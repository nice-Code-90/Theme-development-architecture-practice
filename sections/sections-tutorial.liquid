<p>hello world</p>

<h2>Text Setting</h2>
<p>{{ section.settings.text_setting }}</p>

<h2>Textarea Setting</h2>
<p>{{ section.settings.textarea_setting | newline_to_br }}</p>

<h2>Richtext Setting</h2>
<div>{{ section.settings.richtext_setting }}</div>

<h2>Inline Richtext Setting</h2>
<div>{{ section.settings.inline_richtext_setting }}</div>

<h2>Number Setting</h2>
<div>{{ section.settings.number_setting }}</div>

<h2>Range Setting</h2>
<div>{{ section.settings.range_setting }}</div>

<h2>Select Setting</h2>
<div>{{ section.settings.select_setting }}</div>

<h2>Checkbox Setting</h2>
<div>{{ section.settings.select_setting }}</div>

<h2>Checkbox Settings</h2>
{% if section.settings.checkbox_setting == true %}
    <p>checkbox is true</p>
{% else %}
    <p>checkbox is false</p>
{% endif %}

<h2>Radio Setting</h2>
<div>{{ section.settings.radio_setting }}</div>

<h2>Color Setting</h2>
<p style="color: {{ section.settings.color_setting }}">{{ section.settings.color_setting }}, {{ section.settings.color_setting.lightness }}</p>

<div style="background: {{ section.settings.color_background_setting }}">
    <h2>Color Background Setting</h2>
    <p>{{ section.settings.color_background_setting }}</p>
</div>

<h2>Image Picker Value</h2>
{{ section.settings.image_picker_setting | image_url: width: 400 | image_tag}}


{% schema %}
{
    "name": "Sections Tutorial",
    "tag":"section",
    "class": "section-tutorial",
    "limit": 2,
    "settings": [
        {
            "type": "text",
            "id": "text_setting",
            "label": "Text Setting",
            "default": "This is my first setting",
            "info": "This is some helper text",
            "placeholder": "This is a placeholder"
        },
        {
            "type": "textarea",
            "id": "textarea_setting",
            "label": "Textarea Setting",
            "placeholder": "This is a placeholder"
        },
        {
            "type": "richtext",
            "id": "richtext_setting",
            "label": "Richtext Setting"
        },
        {
            "type": "inline_richtext",
            "id": "inline_richtext_setting",
            "label": "Inline Richtext Setting"
        },
        {
            "type": "number",
            "id": "number_setting",
            "label": "Number Setting",
            "placeholder": "This is a placeholder"
        },
        {
            "type": "range",
            "id": "range_setting",
            "label": "Range Setting",
            "min": 50,
            "max": 150,
            "step": 5,
            "unit": "px",
            "default": 60
        },
        {
            "type": "select",
            "id": "select_setting",
            "label": "Select Setting",
            "options":[
                {
                "value": "value_something_1",
                "label": "Value 1",
                "group": "group-1"
                },
                {
                "value": "value_something_2",
                "label": "Value 2",
                "group": "group-1"
                },
                {
                "value": "value_something_3",
                "label": "Value 3",
                "group": "group-2"
                },
                {
                "value": "value_something_4",
                "label": "Value 4",
                "group": "group-2"
                }
            ]
        },
        {
            "type": "checkbox",
            "id": "checkbox_setting",
            "label": "Checkbox Setting",
            "default": true
        },
        {
            "type": "radio",
            "id": "radio_setting",
            "label": "Radio Button Setting",
            "options": [
                {
                    "value": "value-1",
                    "label": "Value 1"
                },
                {
                    "value": "value-2",
                    "label": "Value 2"
                },
                {
                    "value": "value-3",
                    "label": "Value 3"
                }
            ]   
        },
        {
            "type": "color",
            "label": "Color Setting",
            "id": "color_setting"
        },
        {
            "type": "color_background",
            "label": "Color Background Setting",
            "id": "color_background_setting"
        },
        {
            "type": "image_picker",
            "label": "Image Picker",
            "id": "image_picker"
        }

    ],
    "blocks": [],
    "presets": [
        {
            "name": "Sections Tutorial",
            "settings": {}
        }
        
    ]
}
{% endschema %}