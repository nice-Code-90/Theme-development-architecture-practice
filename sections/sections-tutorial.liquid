<p>hello world</p>

<h2>Text Settings</h2>
<p>{{ section.settings.text_setting }}</p>

<h2>Textarea Settings</h2>
<p>{{ section.settings.textarea_setting }}</p>

{% schema %}
{
    "name": "Sections Tutorial",
    "tag":"section",
    "class": "section-tutorial",
    "limit": 2,
    "settings": [
        {
            "type": "text",
            "id": "text_setting",
            "label": "Text Setting",
            "default": "This is my first setting",
            "info": "This is some helper text"
        },
        {
            "type": "textarea",
            "id": "textarea_setting",
            "label": "Textarea Setting",
        }

    ],
    "blocks": [],
    "presets": [
        {
            "name": "Sections Tutorial",
            "settings": {}
        }
        
    ]
}
{% endschema %}